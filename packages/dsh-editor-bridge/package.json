{
  "name": "@dsh-vscode/editor-bridge",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Optional DSH companion for explicitly shared VS Code editor metadata",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node ../../scripts/build-editor-companion.mjs --package-only",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dsh-vscode/domain": "workspace:*"
  }
}
