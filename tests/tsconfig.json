{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": "..",
    "paths": {
      "@dsh-vscode/domain": ["packages/domain/src/index.ts"],
      "@dsh-vscode/application": ["packages/application/src/index.ts"],
      "@dsh-vscode/dsh-adapter": ["packages/dsh-adapter/src/index.ts"],
      "@dsh-vscode/webview-protocol": ["packages/webview-protocol/src/index.ts"],
      "@dsh-vscode/timeline": ["packages/timeline/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "../packages/domain/src/**/*.ts",
    "../packages/application/src/**/*.ts",
    "../packages/dsh-adapter/src/**/*.ts",
    "../packages/webview-protocol/src/**/*.ts",
    "../packages/timeline/src/**/*.ts",
    "../apps/extension/src/backend/path-safety.ts",
    "../apps/extension/src/backend/skill-documents.ts",
    "../apps/extension/src/backend/process-supervisor.ts",
    "../apps/extension/src/backend/endpoint-network.ts",
    "../apps/extension/src/backend/external-connection-access.ts",
    "../apps/extension/src/backend/credential-scope.ts",
    "../apps/extension/src/editor/editor-context-provider.ts",
    "../apps/extension/src/editor/companion-host-proof.ts",
    "../apps/extension/src/editor/managed-companion.ts",
    "../apps/extension/src/editor/editor-context-store.ts",
    "../apps/extension/src/editor/open-file-id.ts",
    "../apps/extension/src/editor/workspace-path-guard.ts",
    "../apps/extension/src/checkpoints/vscode-checkpoint-adapter.ts",
    "../apps/extension/src/checkpoints/checkpoint-store.ts",
    "../apps/extension/src/checkpoints/checkpoint-persistence.ts",
    "../apps/extension/src/prompts/vscode-prompt-template-adapter.ts",
    "../apps/extension/src/prompts/prompt-template-store.ts",
    "../apps/extension/src/composition/inspector-client-url.ts",
    "../apps/extension/src/backend/adapter-options.ts",
    "../apps/extension/src/backend/version-adapters.ts",
    "../apps/extension/src/backend/windows-shim.ts",
    "../apps/extension/src/changes/change-set-tracker.ts",
    "../apps/extension/src/view/public-value.ts",
    "../apps/extension/src/view/editor-companion-public.ts",
    "../apps/extension/src/view/transcript-window.ts",
    "../apps/extension/src/schedules/schedule-feature-handler.ts",
    "../packages/dsh-adapter/test/fixtures/alpha211-contract.ts",
    "../packages/dsh-adapter/test/support/contract-harness.ts",
    "../packages/dsh-adapter/test/support/streaming-mux.ts"
  ]
}
