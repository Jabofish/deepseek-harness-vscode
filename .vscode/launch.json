{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run JaboDSH Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/extension",
        "${workspaceFolder}/.test-workspace",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/apps/extension/dist/**/*.cjs"],
      "env": {
        "DSH_VSCODE_DEV_MANAGED_RUNTIME": "1"
      },
      "preLaunchTask": "build"
    }
  ]
}
