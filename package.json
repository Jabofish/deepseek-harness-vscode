{
  "name": "dsh-vscode-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JaboDSH, an independent community VS Code client for DeepSeek Harness",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.19.0 <27",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "node scripts/build-editor-companion.mjs && pnpm --filter @dsh-vscode/webview build && pnpm --filter jabodsh build",
    "build:companion": "node scripts/build-editor-companion.mjs",
    "check": "concurrently --kill-others-on-fail -n format,docs,i18n,lint,typecheck,test \"pnpm format:check\" \"pnpm docs:check\" \"pnpm i18n:check\" \"pnpm lint\" \"pnpm typecheck\" \"pnpm test\"",
    "clean": "pnpm -r --if-present clean",
    "dev": "pnpm --parallel --filter @dsh-vscode/webview --filter jabodsh dev",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier/.prettier-cache .",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs check",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache .",
    "package:vsix": "pnpm build && pnpm --filter jabodsh package:vsix",
    "test": "vitest run --passWithNoTests",
    "test:changed": "node scripts/test-changed.mjs",
    "test:stress": "vitest run --config config/vitest.stress.config.ts --tags-filter=stress",
    "test:ui-stability": "node scripts/test-ui-stability.mjs",
    "test:contracts": "node scripts/test-changed.mjs --contracts",
    "test:billing-evidence": "vitest run --config config/vitest.billing.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck && pnpm exec tsc -p tests/tsconfig.json --noEmit && pnpm exec tsc -p tests/billing/tsconfig.json --noEmit && pnpm exec tsc -p config/tsconfig.tools.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/vscode": "1.125.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "concurrently": "^10.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
