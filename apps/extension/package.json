{
  "name": "deepseek-harness-client",
  "displayName": "DeepSeek Harness Companion for VS Code",
  "description": "Run DSH sessions, tools, and coding tasks in VS Code.",
  "version": "0.2.1",
  "publisher": "Direwolf",
  "icon": "resources/dsh.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jabofish/deepseek-harness-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Jabofish/deepseek-harness-vscode/issues"
  },
  "homepage": "https://github.com/Jabofish/deepseek-harness-vscode#readme",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22.19.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "agent",
    "coding assistant"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onView:dsh.chatView",
    "onCommand:dsh.connect",
    "onCommand:dsh.reconnect",
    "onCommand:dsh.newSession",
    "onCommand:dsh.openWebUi",
    "onCommand:dsh.installRuntime",
    "onCommand:dsh.addSelectionContext",
    "onCommand:dsh.addFileContext",
    "onCommand:dsh.addSymbolContext",
    "onCommand:dsh.addDiagnosticContext"
  ],
  "files": [
    "dist/**",
    "media/**",
    "resources/**",
    "README.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "node esbuild.mjs --watch",
    "prepackage:vsix": "node -e \"require('node:fs').mkdirSync('../../artifacts',{recursive:true})\"",
    "package:vsix": "vsce package --no-dependencies -o ../../artifacts/deepseek-harness-vscode.vsix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dsh-vscode/application": "workspace:*",
    "@dsh-vscode/domain": "workspace:*",
    "@dsh-vscode/dsh-adapter": "workspace:*",
    "@dsh-vscode/webview-protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/vscode": "1.125.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-container",
          "title": "DeepSeek Harness",
          "icon": "resources/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh-container": [
        {
          "id": "dsh.chatView",
          "name": "Chat",
          "type": "webview",
          "visibility": "visible",
          "icon": "resources/dsh.svg",
          "contextualTitle": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.connect",
        "title": "DSH: Connect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dsh.reconnect",
        "title": "DSH: Connected (Reconnect)",
        "icon": {
          "light": "resources/connected.svg",
          "dark": "resources/connected.svg"
        }
      },
      {
        "command": "dsh.newSession",
        "title": "DSH: Open Sessions",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dsh.openSettings",
        "title": "DSH: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dsh.openWebUi",
        "title": "DSH: Open Web UI",
        "icon": "$(globe)"
      },
      {
        "command": "dsh.installRuntime",
        "title": "DSH: Install DeepSeek Harness"
      },
      {
        "command": "dsh.selectExecutable",
        "title": "DSH: Select Executable"
      },
      {
        "command": "dsh.copyInstallCommand",
        "title": "DSH: Copy Install Command"
      },
      {
        "command": "dsh.openDocumentation",
        "title": "DSH: Open Documentation"
      },
      {
        "command": "dsh.openInSecondarySidebar",
        "title": "DSH: Move View to Secondary Side Bar"
      },
      {
        "command": "dsh.showDiagnostics",
        "title": "DSH: Show Redacted Diagnostics"
      },
      {
        "command": "dsh.addSelectionContext",
        "title": "DSH: Add Selection to Context",
        "icon": "$(selection)"
      },
      {
        "command": "dsh.addFileContext",
        "title": "DSH: Add File to Context",
        "icon": "$(file)"
      },
      {
        "command": "dsh.addSymbolContext",
        "title": "DSH: Add Symbol to Context",
        "icon": "$(symbol-method)"
      },
      {
        "command": "dsh.addDiagnosticContext",
        "title": "DSH: Add Diagnostic to Context",
        "icon": "$(error)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dsh.newSession",
          "when": "view == dsh.chatView",
          "group": "navigation@1"
        },
        {
          "command": "dsh.connect",
          "when": "view == dsh.chatView && !dsh.connected",
          "group": "navigation@2"
        },
        {
          "command": "dsh.reconnect",
          "when": "view == dsh.chatView && dsh.connected",
          "group": "navigation@2"
        },
        {
          "command": "dsh.openSettings",
          "when": "view == dsh.chatView",
          "group": "navigation@3"
        },
        {
          "command": "dsh.openWebUi",
          "when": "view == dsh.chatView && dsh.connected",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "dsh.addSelectionContext",
          "when": "editorTextFocus && dsh.editorContext.selectionAvailable",
          "group": "dsh@1"
        },
        {
          "command": "dsh.addFileContext",
          "when": "editorTextFocus && dsh.editorContext.fileAvailable",
          "group": "dsh@2"
        },
        {
          "command": "dsh.addSymbolContext",
          "when": "editorTextFocus && dsh.editorContext.symbolAvailable",
          "group": "dsh@3"
        },
        {
          "command": "dsh.addDiagnosticContext",
          "when": "editorTextFocus && dsh.editorContext.diagnosticAvailable",
          "group": "dsh@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "dsh.addSelectionContext",
          "when": "editorLangId != '' && dsh.editorContext.selectionAvailable",
          "group": "dsh@1"
        },
        {
          "command": "dsh.addFileContext",
          "when": "editorLangId != '' && dsh.editorContext.fileAvailable",
          "group": "dsh@2"
        },
        {
          "command": "dsh.addSymbolContext",
          "when": "editorLangId != '' && dsh.editorContext.symbolAvailable",
          "group": "dsh@3"
        },
        {
          "command": "dsh.addDiagnosticContext",
          "when": "editorLangId != '' && dsh.editorContext.diagnosticAvailable",
          "group": "dsh@4"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "dsh.connection.mode": {
          "type": "string",
          "enum": [
            "auto",
            "custom",
            "attach-only",
            "new-isolated"
          ],
          "default": "auto",
          "markdownDescription": "Connection policy. `auto` discovers and starts a local DSH as needed; `custom` probes only the configured local endpoint; `attach-only` never starts DSH; `new-isolated` always starts an extension-owned instance."
        },
        "dsh.connection.managedPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "Port for an extension-managed DSH. Zero asks DSH to select a free port."
        },
        "dsh.connection.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Optional existing local DSH URL, restricted to http://127.0.0.1 or http://localhost."
        },
        "dsh.connection.attachPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "default": [
            3080
          ],
          "description": "Additional local ports probed when looking for an already-running DSH instance."
        },
        "dsh.connection.discoveryTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "default": 1500,
          "description": "Maximum time for one local DSH discovery pass."
        },
        "dsh.connection.requestTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 30000,
          "description": "Default timeout for non-streaming DSH requests."
        },
        "dsh.runtime.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional absolute path to the DSH executable. Leave empty for automatic discovery."
        },
        "dsh.runtime.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start a local DSH only after no compatible running instance can be attached."
        },
        "dsh.agent.defaultPreset": {
          "type": "string",
          "default": "standard",
          "description": "Default DSH agent preset for new sessions; deployments may provide additional ids."
        },
        "dsh.agent.toolMode": {
          "type": "string",
          "enum": [
            "native",
            "ptc",
            "code",
            "both"
          ],
          "default": "native",
          "description": "Default DSH tool mode for new sessions. Alpha runtimes use ptc; code is retained for published rc runtimes."
        },
        "dsh.agent.permissionPreset": {
          "type": "string",
          "default": "workspace-write",
          "description": "Default permission preset supplied by the connected DSH permission plugin."
        },
        "dsh.agent.planMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable DSH plan mode by default for new sessions."
        },
        "dsh.model.provider": {
          "type": "string",
          "default": "",
          "description": "Optional default provider id. Leave empty to use DSH configuration."
        },
        "dsh.model.id": {
          "type": "string",
          "default": "",
          "description": "Optional default model id. Leave empty to use DSH configuration."
        },
        "dsh.model.reasoningLevel": {
          "type": "string",
          "default": "",
          "description": "Optional default reasoning level when supported by the selected model."
        },
        "dsh.checkpoints.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable explicit local checkpoint metadata. Restore requires content storage to be enabled separately."
        },
        "dsh.checkpoints.storeContent": {
          "type": "boolean",
          "default": false,
          "description": "Allow explicit checkpoint content snapshots in extension global storage. Source code remains sensitive and is not encrypted by this setting."
        },
        "dsh.promptTemplates.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local prompt templates. Templates are user-authored text and are inserted into the composer only after explicit user action."
        },
        "dsh.developer.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Extension diagnostics verbosity. Secrets and prompt bodies are always redacted."
        }
      }
    }
  }
}
